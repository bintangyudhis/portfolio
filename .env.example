# Portfolio environment — copy this file to .env.local and fill in real
# values. .env.local is gitignored; NEVER commit real values.
#
# Data sources, in the order src/lib/db.ts tries them for page content:
#   1. Supabase REST (the two NEXT_PUBLIC_* values below) — read-only via
#      RLS, no database password needed. This is the normal setup.
#   2. DATABASE_URL (direct Postgres) — optional alternative.
#   3. Built-in curated fallback (src/lib/content.ts) — always available.
#
# Get the values from Supabase Dashboard → Project `dompetku` →
# Project Settings → API (Project URL + API keys).

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (Project Settings → API → anon public).
# Safe to expose: content tables are RLS read-only for this role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Project Settings → API → service_role). SERVER ONLY —
# bypasses RLS; used solely to insert contact-form messages into
# portfolio_messages. Never prefix with NEXT_PUBLIC_, never commit it.
# Without it (and without DATABASE_URL) the contact form answers 503.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres connection string for the same project
# (server-side only). Alternative content source and message store.
DATABASE_URL=

# --- Admin CMS (/admin) -------------------------------------------------
# Password for the single-owner admin login at /admin/login. SERVER ONLY.
# Without it the CMS login is disabled (the API answers 503).
ADMIN_PASSWORD=

# Optional secret used to sign the admin session cookie (HMAC). When
# empty, ADMIN_PASSWORD itself is used as the signing secret — set a
# separate long random value in production so the password can be rotated
# without invalidating the signer (and vice versa). SERVER ONLY.
ADMIN_SESSION_SECRET=
